{
  "manifest_version": 3,
  "name": "Volume Mixer — Per-Tab Audio",
  "version": "1.1.0",
  "description": "Позволяет отдельно регулировать громкость каждой вкладки с видео или звуком и управлять воспроизведением в Windows Volume Mixer.",
  "permissions": [
    "tabs",
    "alarms",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page_bridge.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
