<Window x:Class="VolumeMixer.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Volume Mixer"
        Width="360"
        Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent"
        Foreground="#F2FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="12"
                            GlassFrameThickness="-1"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PlayPausePathStyle" TargetType="Path">
            <Setter Property="Fill" Value="#F5FFFFFF"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Data" Value="M 2,1 L 12,7 L 2,13 Z"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Data" Value="M 2,1 L 5.2,1 L 5.2,13 L 2,13 Z M 8.8,1 L 12,1 L 12,13 L 8.8,13 Z"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="LockScreenMediaDrawerTemplate">
            <Border x:Name="DrawerRoot"
                    Background="#2C0B0D13"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,9"
                    Margin="0,8,0,0"
                    Opacity="0"
                    Visibility="Collapsed">
                <Border.LayoutTransform>
                    <ScaleTransform ScaleY="0"/>
                </Border.LayoutTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)"
                                                             From="0" To="1" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.13"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- Row 1: Thumbnail + Title + Artist -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="42" Height="42"
                                CornerRadius="8"
                                Background="#18FFFFFF"
                                Margin="0,0,10,0">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,42,42" RadiusX="8" RadiusY="8"/>
                            </Border.Clip>
                            <Image Source="{Binding EffectiveThumbnail}"
                                   Width="42" Height="42"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MediaTitle}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="#F5FFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding MediaTitle}"/>
                            <TextBlock Text="{Binding MediaArtist}"
                                       FontSize="11"
                                       Foreground="#8CFFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Transport controls (Prev / PlayPause / Next) -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,7,0,0">
                        <Button Style="{StaticResource TransportButtonStyle}"
                                IsEnabled="{Binding CanPrev}"
                                Click="PrevTrackBtn_Click"
                                ToolTip="Назад">
                            <Path Width="13" Height="13"
                                  Fill="#F5FFFFFF"
                                  Stretch="Uniform"
                                  Data="M 1,1 L 3,1 L 3,13 L 1,13 Z M 13,1 L 4,7 L 13,13 Z"/>
                        </Button>
                        <Button Style="{StaticResource TransportButtonStyle}"
                                Width="40" Height="32"
                                Margin="12,0,12,0"
                                Click="PlayPauseTrackBtn_Click"
                                ToolTip="Play / Pause">
                            <Path Width="15" Height="15" Style="{StaticResource PlayPausePathStyle}"/>
                        </Button>
                        <Button Style="{StaticResource TransportButtonStyle}"
                                IsEnabled="{Binding CanNext}"
                                Click="NextTrackBtn_Click"
                                ToolTip="Вперёд">
                            <Path Width="13" Height="13"
                                  Fill="#F5FFFFFF"
                                  Stretch="Uniform"
                                  Data="M 1,1 L 10,7 L 1,13 Z M 11,1 L 13,1 L 13,13 L 11,13 Z"/>
                        </Button>
                    </StackPanel>

                    <!-- Row 3: Progress bar + timestamps -->
                    <Grid Margin="0,5,0,0"
                          Visibility="{Binding ShowTimeline, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding PositionText}"
                                   FontSize="10.5"
                                   Foreground="#88FFFFFF"
                                   VerticalAlignment="Center"
                                   MinWidth="32"/>
                        <Slider Grid.Column="1"
                                Style="{StaticResource LockScreenProgressSliderStyle}"
                                Maximum="{Binding SeekMaximum}"
                                Value="{Binding PositionSeconds, Mode=TwoWay}"
                                IsEnabled="{Binding CanSeek}"
                                Margin="6,0,6,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding DurationText}"
                                   FontSize="10.5"
                                   Foreground="#88FFFFFF"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   MinWidth="32"/>
                    </Grid>

                    <!-- Live badge when stream has no finite duration -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0"
                                Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                        <Ellipse Width="6" Height="6" Fill="#FFFF453A" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold" Foreground="#CCFFFFFF"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#08000000" Opacity="0" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale" ScaleX="0.96" ScaleY="0.96"/>
                <TranslateTransform x:Name="SlideTransform" Y="18"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Border BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="12"/>

        <Grid Margin="14,12,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="2,0,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle"
                               Text="Микшер громкости"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#F5FFFFFF"/>
                    <TextBlock x:Name="HeaderSubtitle"
                               Text="Динамики"
                               FontSize="11"
                               Foreground="#88FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsBtn"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Настройки и бинды"
                            Click="SettingsBtn_Click"
                            Margin="0,0,6,0">
                        <TextBlock x:Name="SettingsBtnIcon" Text="⚙" FontSize="13" Margin="0,-1,0,0"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="Скрыть (Esc)"
                            Click="CloseBtn_Click">
                        <TextBlock Text="✕" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Mixer View -->
            <Grid x:Name="MixerPanel" Grid.Row="1">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="MixerSlide" X="0"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Master Volume Card -->
                <Border Grid.Row="0"
                        Background="#1AFFFFFF"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="11,10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton x:Name="MasterMuteBtn"
                                          Grid.Column="0"
                                          Style="{StaticResource MuteToggleStyle}"
                                          Checked="MasterMuteBtn_Changed"
                                          Unchecked="MasterMuteBtn_Changed"
                                          Margin="0,0,10,0">
                                <TextBlock x:Name="MasterMuteIcon" Text="🔊" FontSize="12"/>
                            </ToggleButton>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Общий звук"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F2FFFFFF"
                                           Margin="0,0,0,5"/>
                                <Slider x:Name="MasterSlider"
                                        Style="{StaticResource MacPillSliderStyle}"
                                        ValueChanged="MasterSlider_ValueChanged"
                                        PreviewMouseWheel="VolumeSlider_PreviewMouseWheel"/>
                            </StackPanel>

                            <TextBlock x:Name="MasterPercentText"
                                       Grid.Column="2"
                                       Text="100%"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="#CCFFFFFF"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,1"/>
                        </Grid>

                        <!-- CoreAudioTray Profile Switch + Devices Drawer Toggle -->
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="ProfileSwitchBar"
                                        Grid.Column="0"
                                        Orientation="Horizontal">
                                <Button x:Name="HeadsetProfileBtn"
                                        Click="HeadsetProfileBtn_Click"
                                        Padding="9,4"
                                        Margin="0,0,5,0"
                                        FontSize="11"
                                        Foreground="#F0FFFFFF"
                                        Background="#14FFFFFF"
                                        Cursor="Hand"
                                        ToolTip="Переключить выход и микрофон на наушники">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="🎧 Наушники"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="SpeakersProfileBtn"
                                        Click="SpeakersProfileBtn_Click"
                                        Padding="9,4"
                                        FontSize="11"
                                        Foreground="#F0FFFFFF"
                                        Background="#14FFFFFF"
                                        Cursor="Hand"
                                        ToolTip="Переключить выход на спикеры и настольный микрофон">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="🔊 Спикеры"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <Button x:Name="DevicesDrawerBtn"
                                    Grid.Column="1"
                                    Content="Раздельно ▾"
                                    Click="DevicesDrawerBtn_Click"
                                    Padding="8,4"
                                    FontSize="11"
                                    Foreground="#CCFFFFFF"
                                    Background="#12FFFFFF"
                                    Cursor="Hand"
                                    ToolTip="Переключить выход и микрофон по отдельности">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Expandable Output / Input Picker (CoreAudioTray profiles only) -->
                        <Grid x:Name="DevicesDrawer" Visibility="Collapsed" Opacity="0" Margin="0,9,0,0">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="DevicesDrawerScale" ScaleY="0"/>
                            </Grid.LayoutTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Output column -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ВЫХОД"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="#75FFFFFF"
                                           Margin="2,0,0,4"/>
                                <ItemsControl x:Name="OutputsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="SelectOutputDevice_Click"
                                                    Tag="{Binding Id}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="7,5"
                                                    Margin="0,0,0,4"
                                                    Cursor="Hand"
                                                    Background="#12FFFFFF">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="#30FFFFFF"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                                    <Setter Property="Fill" Value="#FF30D158"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Name}"
                                                                           FontSize="11"
                                                                           Foreground="#EBFFFFFF"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Input column -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="МИКРОФОН"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="#75FFFFFF"
                                           Margin="2,0,0,4"/>
                                <ItemsControl x:Name="InputsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="SelectInputDevice_Click"
                                                    Tag="{Binding Id}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="7,5"
                                                    Margin="0,0,0,4"
                                                    Cursor="Hand"
                                                    Background="#12FFFFFF">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="#30FFFFFF"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                                    <Setter Property="Fill" Value="#FF30D158"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Name}"
                                                                           FontSize="11"
                                                                           Foreground="#EBFFFFFF"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Apps & Tabs List -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Browser Tabs Section -->
                        <StackPanel x:Name="TabsSection" Visibility="Collapsed" Margin="0,0,0,10">
                            <TextBlock Text="ВКЛАДКИ БРАУЗЕРА"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#7AFFFFFF"
                                       Margin="4,0,0,6"/>
                            <ItemsControl x:Name="BrowserTabsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#14FFFFFF"
                                                BorderBrush="#18FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="11"
                                                Padding="10,8"
                                                Margin="0,0,0,6">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ToggleButton Grid.Column="0"
                                                                  Style="{StaticResource MuteToggleStyle}"
                                                                  IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                                  ToolTip="Вкл/Выкл звук"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,6,0">
                                                        <Grid Width="18" Height="18">
                                                            <TextBlock Text="🔊" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding Icon}"
                                                                   Width="16" Height="16"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Grid>
                                                    </ToggleButton>

                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Width="24" Height="24"
                                                            Visibility="{Binding CanControlPlayback, Converter={StaticResource BoolToVis}}"
                                                            Click="PlayPauseTrackBtn_Click"
                                                            ToolTip="Play / Pause"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0">
                                                        <Path Width="9" Height="9" Style="{StaticResource PlayPausePathStyle}"/>
                                                    </Button>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Title}"
                                                                       FontSize="12"
                                                                       FontWeight="Medium"
                                                                       Foreground="#F0FFFFFF"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Title}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding BrowserName}"
                                                                       FontSize="10"
                                                                       Foreground="#78FFFFFF"
                                                                       Margin="6,1,0,0"/>
                                                        </Grid>
                                                        <Slider Style="{StaticResource MacPillSliderStyle}"
                                                                Value="{Binding Volume, Mode=TwoWay}"
                                                                PreviewMouseWheel="VolumeSlider_PreviewMouseWheel"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Bottom"
                                                                Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding VolumeText}"
                                                                   FontSize="11.5"
                                                                   Foreground="#B8FFFFFF"
                                                                   Width="32"
                                                                   TextAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource IconButtonStyle}"
                                                                Width="20" Height="20"
                                                                Margin="4,0,0,0"
                                                                Visibility="{Binding CanControlPlayback, Converter={StaticResource BoolToVis}}"
                                                                Click="ExpandMediaBtn_Click"
                                                                ToolTip="Управление плеером">
                                                            <TextBlock Text="{Binding ExpandGlyph}" FontSize="10"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource LockScreenMediaDrawerTemplate}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Applications Section -->
                        <TextBlock Text="ПРИЛОЖЕНИЯ"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#7AFFFFFF"
                                   Margin="4,0,0,6"/>

                        <ItemsControl x:Name="AppSessionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#14FFFFFF"
                                            BorderBrush="#18FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="11"
                                            Padding="10,8"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ToggleButton Grid.Column="0"
                                                              Style="{StaticResource MuteToggleStyle}"
                                                              IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                              ToolTip="Вкл/Выкл звук"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,6,0">
                                                    <Grid Width="18" Height="18">
                                                        <TextBlock Text="🔔" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding Icon}"
                                                               Width="16" Height="16"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                </ToggleButton>

                                                <Button Grid.Column="1"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Width="24" Height="24"
                                                        Visibility="{Binding CanControlPlayback, Converter={StaticResource BoolToVis}}"
                                                        Click="PlayPauseTrackBtn_Click"
                                                        ToolTip="Play / Pause"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0">
                                                    <Path Width="9" Height="9" Style="{StaticResource PlayPausePathStyle}"/>
                                                </Button>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="#F0FFFFFF"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,0,4"/>
                                                    <Slider Style="{StaticResource MacPillSliderStyle}"
                                                            Value="{Binding Volume, Mode=TwoWay}"
                                                            PreviewMouseWheel="VolumeSlider_PreviewMouseWheel"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Bottom"
                                                            Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding VolumeText}"
                                                               FontSize="11.5"
                                                               Foreground="#B8FFFFFF"
                                                               Width="32"
                                                               TextAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                    <Button Style="{StaticResource IconButtonStyle}"
                                                            Width="20" Height="20"
                                                            Margin="4,0,0,0"
                                                            Visibility="{Binding CanControlPlayback, Converter={StaticResource BoolToVis}}"
                                                            Click="ExpandMediaBtn_Click"
                                                            ToolTip="Управление плеером">
                                                        <TextBlock Text="{Binding ExpandGlyph}" FontSize="10"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource LockScreenMediaDrawerTemplate}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyAppsText"
                                   Text="Нет активных аудиосессий"
                                   FontSize="12"
                                   Foreground="#66FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,18,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Settings View -->
            <ScrollViewer x:Name="SettingsPanel"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform x:Name="SettingsSlide" X="0"/>
                </ScrollViewer.RenderTransform>
                <StackPanel>
                    <!-- Hotkeys Card -->
                    <Border Background="#16FFFFFF"
                            BorderBrush="#1EFFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#7AFFFFFF"
                                       Margin="0,0,0,8"/>

                            <!-- Toggle Mixer Bind -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Вызов микшера"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Foreground="#EBFFFFFF"/>
                                <Button x:Name="BindToggleBtn"
                                        Grid.Column="1"
                                        Tag="Toggle"
                                        Click="BindBtn_Click"
                                        Padding="10,5"
                                        Background="#1CFFFFFF"
                                        Foreground="#F0FFFFFF"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        FontSize="11.5">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Master Mute Bind -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Мут общего звука"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Foreground="#EBFFFFFF"/>
                                <Button x:Name="BindMasterMuteBtn"
                                        Grid.Column="1"
                                        Tag="MasterMute"
                                        Click="BindBtn_Click"
                                        Padding="10,5"
                                        Background="#1CFFFFFF"
                                        Foreground="#F0FFFFFF"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        FontSize="11.5">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="2"
                                        Tag="MasterMute"
                                        Click="ClearBindBtn_Click"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="24" Height="24"
                                        Margin="4,0,0,0"
                                        ToolTip="Очистить">
                                    <TextBlock Text="✕" FontSize="9"/>
                                </Button>
                            </Grid>

                            <!-- Active Window Mute Bind -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Мут активного окна"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Foreground="#EBFFFFFF"/>
                                <Button x:Name="BindActiveMuteBtn"
                                        Grid.Column="1"
                                        Tag="ActiveMute"
                                        Click="BindBtn_Click"
                                        Padding="10,5"
                                        Background="#1CFFFFFF"
                                        Foreground="#F0FFFFFF"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        FontSize="11.5">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="2"
                                        Tag="ActiveMute"
                                        Click="ClearBindBtn_Click"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="24" Height="24"
                                        Margin="4,0,0,0"
                                        ToolTip="Очистить">
                                    <TextBlock Text="✕" FontSize="9"/>
                                </Button>
                            </Grid>

                            <TextBlock x:Name="BindHintText"
                                       Text="Нажмите на кнопку и выберите комбинацию клавиш"
                                       FontSize="10.5"
                                       Foreground="#75FFFFFF"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Appearance & Startup Card -->
                    <Border Background="#16FFFFFF"
                            BorderBrush="#1EFFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="СИСТЕМА И СТИЛЬ"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#7AFFFFFF"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Эффект прозрачности"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Foreground="#EBFFFFFF"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="AcrylicBtn"
                                            Content="Acrylic"
                                            Click="BackdropBtn_Click"
                                            Tag="Acrylic"
                                            Padding="9,4"
                                            FontSize="11"
                                            Margin="0,0,4,0"
                                            Cursor="Hand"
                                            Foreground="#F0FFFFFF"
                                            Background="#2AFFFFFF"
                                            BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="MicaBtn"
                                            Content="Mica"
                                            Click="BackdropBtn_Click"
                                            Tag="Mica"
                                            Padding="9,4"
                                            FontSize="11"
                                            Cursor="Hand"
                                            Foreground="#AAFFFFFF"
                                            Background="#12FFFFFF"
                                            BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Автозапуск с Windows"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Foreground="#EBFFFFFF"/>
                                <CheckBox x:Name="StartupSwitch"
                                          Grid.Column="1"
                                          Style="{StaticResource MacSwitchStyle}"
                                          Checked="StartupSwitch_Changed"
                                          Unchecked="StartupSwitch_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Browser Extension Status Card -->
                    <Border Background="#16FFFFFF"
                            BorderBrush="#1EFFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="РАСШИРЕНИЕ БРАУЗЕРА"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#7AFFFFFF"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ExtStatusDot" Width="7" Height="7" Fill="#FFFF9F0A" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="ExtStatusText" Text="Ожидание" FontSize="10.5" Foreground="#B8FFFFFF"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Для громкости отдельных вкладок установите папку VolumeMixer.Extension в режиме разработчика (chrome://extensions)."
                                       FontSize="11"
                                       Foreground="#88FFFFFF"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <Button x:Name="CopyExtPathBtn"
                                    Content="Копировать путь к расширению"
                                    Click="CopyExtPathBtn_Click"
                                    Padding="10,6"
                                    FontSize="11.5"
                                    Foreground="#F0FFFFFF"
                                    Background="#22FFFFFF"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
